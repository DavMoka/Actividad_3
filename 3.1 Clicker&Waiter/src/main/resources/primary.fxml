<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="50.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Primary">
   <children>
       <VBox alignment="CENTER" spacing="20">
           <Label text="Contador de número de clicks"/>
           <Label text="0" fx:id="lblClick"/>
           <Button text="¡Contar!" onAction="#actionClick"/>
       </VBox>
       <VBox alignment="CENTER" spacing="20">
           <Label text="Esperar 10 segundos"/>
           <HBox alignment="CENTER" spacing="10">
               <Label text="¡Listo!" fx:id="lblWait"/>
               <ProgressBar fx:id="barWait" progress="100"/>
           </HBox>
           <Button text="¡Esperar!" fx:id="btnWait" onAction="#actionWait"/>
       </VBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
